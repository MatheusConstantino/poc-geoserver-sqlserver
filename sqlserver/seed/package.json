{
  "name": "poc-seed-generator",
  "version": "1.0.0",
  "description": "Synthetic geospatial data generator for poc-geoserver-sqlserver",
  "private": true,
  "scripts": {
    "generate": "ts-node --project tsconfig.json src/generate.ts",
    "generate:sqlserver": "ts-node src/generate.ts --db sqlserver",
    "generate:postgis": "ts-node src/generate.ts --db postgis",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "mssql": "^11.0.1",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}

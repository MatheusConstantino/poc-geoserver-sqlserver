# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.js.map

# Environment variables — NEVER commit real values
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Docker volumes (local mounts)
.docker-volumes/

# Benchmark raw output (keep only processed results)
benchmark/results/*.csv
benchmark/results/*.json
!benchmark/results/*.md

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# TypeScript cache
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# GeoServer local data (mounted at runtime)
geoserver/data_dir/workspaces/*/

# Temporary files
tmp/
temp/
*.tmp
